# Copy to .env, fill in real values, NEVER commit .env.
# Type these directly on the VPS — do not paste credentials into a Claude Code session.

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

MCP_HOST=127.0.0.1
MCP_PORT=8080

# How many days BEFORE the firm's inactivity threshold to start alerting.
# The threshold itself lives in docs/rule-map-template.md, per firm.
INACTIVITY_ALERT_DAYS=3
